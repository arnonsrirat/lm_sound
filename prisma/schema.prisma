generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // เชื่อมโยงกับ Spot (ของ Arnon)
  // หมายเหตุ: คอมเมนต์ไว้ก่อนได้หากโมเดล Spot ยังไม่ถูกผสานเข้ามา เพื่อไม่ให้ Prisma แจ้งเตือน Error
  spots        Spot[]
}

// โครง Stub เบื้องต้นสำหรับ Spot เพื่อป้องกัน Prisma Compile Error ระหว่างรอ Arnon
model Spot {
  id        String   @id @default(cuid())
  title     String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
