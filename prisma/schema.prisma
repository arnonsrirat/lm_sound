// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("USER") // "USER" | "ADMIN"
  spots     Spot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// การตั้งค่าเว็บไซต์ที่แอดมินปรับแต่งได้ โดยไม่ต้องแก้โค้ด
model SiteSetting {
  id                   String   @id @default(cuid())
  key                  String   @unique
  value                String
  updatedAt            DateTime @updatedAt
}

model GoogleDriveConnection {
  id                    String   @id @default(cuid())
  accountEmail          String?
  refreshTokenEncrypted String
  rootFolderId          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MediaAsset {
  id              String   @id @default(cuid())
  name            String
  note            String?
  folder          String
  mimeType        String
  size            Int
  driveFileId     String   @unique
  driveWebViewUrl String?
  url             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([folder, createdAt])
}

model Spot {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  noiseLevel  String   // e.g. "quiet" (เงียบสงบ), "moderate" (ปานกลาง), "lively" (คึกคัก)
  imageUrl    String
  audioUrl    String
  latitude    Float?
  longitude   Float?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}
